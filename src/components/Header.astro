---
import { Image } from 'astro:assets';
import appIcon from '../assets/images/app-icon.png';
import { NAV } from '../config';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Trust Issues home">
      <Image src={appIcon} alt="" width={36} height={36} densities={[1, 2]} loading="eager" class="brand-icon" />
      <span class="wordmark">Trust Issues</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li class={item.href.startsWith('/#') ? 'anchor' : ''}>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(11 14 26 / 0.72);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-primary);
    text-decoration: none;
    min-height: var(--tap);
    flex: none;
  }
  .brand-icon {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    box-shadow: 0 0 0 1px rgb(167 139 250 / 0.3);
  }
  .wordmark {
    font-family: var(--font-rounded);
    font-weight: 900;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }
  ul {
    display: flex;
    gap: clamp(0.25rem, 1.5vw, 1.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 0.5rem;
    font-family: var(--font-rounded);
    font-weight: 750;
    font-size: 0.95rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 10px;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text-primary);
  }
  nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent-primary);
    border-radius: 0;
  }
  @media (max-width: 620px) {
    .anchor {
      display: none;
    }
    .wordmark {
      font-size: 1.05rem;
    }
  }
  @media (max-width: 360px) {
    .wordmark {
      display: none;
    }
  }
</style>
