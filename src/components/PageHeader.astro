---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  narrator?: string;
}
const { eyebrow, title, lede, narrator } = Astro.props;
---

<header class="page-header">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {narrator && <p class="narrator line">{narrator}</p>}
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    position: relative;
    padding-block: clamp(3.5rem, 2rem + 6vw, 6.5rem) clamp(2rem, 1.5rem + 2vw, 3rem);
    background:
      radial-gradient(60rem 26rem at 85% -10%, rgb(167 139 250 / 0.18), transparent 70%),
      radial-gradient(30rem 18rem at 10% 0%, rgb(199 210 254 / 0.07), transparent 70%),
      var(--bg-night-base);
    border-bottom: 1px solid var(--rule);
  }
  h1 {
    margin-top: 0.75rem;
    font-size: var(--step-5);
  }
  .line {
    margin-top: 1rem;
    font-size: var(--step-2);
    color: var(--accent-moon);
    max-width: 36ch;
  }
  .lede {
    margin-top: 1rem;
    max-width: 44rem;
    font-size: var(--step-1);
    color: var(--text-secondary);
  }
</style>
