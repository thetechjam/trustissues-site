---
/**
 * Primary + secondary calls to action.
 * - Primary: Apple's official "Download on the App Store" badge (white,
 *   US-English, unmodified; see src/assets/badges/README.md) linking to
 *   APP_STORE_URL (src/config.ts). White is Apple's alternative badge, used
 *   because the black one disappears on this dark-only site and no other
 *   store badge appears. Shown at 56px tall (min 40px) with >= 1/4-height
 *   clear space. CSS may only size/align it: no shadows, filters or borders.
 *   If APP_STORE_URL is ever `null`, falls back to a NON-link "Coming soon"
 *   pill in the site's own tokens (never Apple's artwork for an unreleased app).
 * - Secondary: TestFlight beta → TESTFLIGHT_URL, or /support/#beta while null.
 */
import Glyph from './Glyph.astro';
// `?url` emits the official SVG byte-for-byte (no Astro SVG component processing).
import appStoreBadge from '../assets/badges/download-on-the-app-store-white-en-us.svg?url';
import { APP_STORE_URL, TESTFLIGHT_URL, betaHref } from '../config';

interface Props {
  align?: 'start' | 'center';
}
const { align = 'start' } = Astro.props;
const external = TESTFLIGHT_URL !== null;
// Official artwork is 119.66407 x 40; scale uniformly to 56px tall.
const BADGE_H = 56;
const BADGE_W = Math.round((BADGE_H * 119.66407) / 40);
---

<div class:list={['cta-group', align]}>
  {
    APP_STORE_URL ? (
      <a class="app-store-badge" href={APP_STORE_URL}>
        <img src={appStoreBadge} alt="Download on the App Store" width={BADGE_W} height={BADGE_H} decoding="async" />
      </a>
    ) : (
      <p class="store-badge" role="note">
        <Glyph name="phone" class="badge-icon" />
        <span>
          <small>Coming soon on the</small>
          App Store
        </span>
      </p>
    )
  }
  <a class="btn btn-secondary beta" href={betaHref} {...(external ? { rel: 'noopener' } : {})}>
    Join the TestFlight beta
    <Glyph name="arrow" />
  </a>
</div>

<style>
  .cta-group {
    display: flex;
    flex-wrap: wrap;
    /* >= 14px (1/4 of the 56px badge height): Apple's minimum clear space. */
    gap: 1rem;
    align-items: center;
  }
  /* Apple badge: size and alignment only. Never filters/shadows/borders/backgrounds. */
  .app-store-badge {
    display: inline-flex;
    flex: none;
    line-height: 0;
  }
  .app-store-badge img {
    display: block;
    width: auto;
    height: 56px;
    max-width: none;
  }
  .cta-group.center {
    justify-content: center;
  }
  .store-badge {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 56px;
    padding: 0.55rem 1.25rem 0.55rem 1rem;
    border-radius: var(--radius-control);
    /* Pre-launch fallback only. Not Apple's artwork: a pill in the app's own tokens. */
    background: linear-gradient(180deg, #05060c, #0b0e1a);
    color: var(--text-primary);
    font-family: var(--font-rounded);
    font-weight: 900;
    font-size: 1.15rem;
    line-height: 1.05;
    text-decoration: none;
    box-shadow:
      inset 0 0 0 1.5px rgb(199 210 254 / 0.45),
      0 12px 34px -14px rgb(167 139 250 / 0.7);
    cursor: default;
  }
  .store-badge small {
    display: block;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-moon);
  }
  .store-badge :global(.badge-icon) {
    color: var(--accent-primary);
  }
  .store-badge :global(.badge-icon) {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
  }
  .beta {
    min-height: 56px;
  }
  @media (max-width: 420px) {
    .cta-group {
      justify-content: center;
    }
    .cta-group > :not(.app-store-badge) {
      width: 100%;
      justify-content: center;
    }
  }
</style>
