---
/**
 * CSS-drawn iPhone-style frame (no Apple marketing assets). Pass `image` for a
 * real screenshot, or null for the clearly-marked placeholder slot.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata | null;
  alt: string;
  eager?: boolean;
}
const { image, alt, eager = false } = Astro.props;
---

<div class="phone">
  <div class="screen">
    {
      image ? (
        <Image
          src={image}
          alt={alt}
          widths={[280, 420, 560]}
          sizes="(max-width: 600px) 64vw, 280px"
          loading={eager ? 'eager' : 'lazy'}
          quality={78}
        />
      ) : (
        // PLACEHOLDER: shown for any gallery slot without an image (src/data/screenshots.ts).
        <div class="placeholder" role="img" aria-label="Screenshot coming soon">
          <span class="moon" aria-hidden="true">☾</span>
          <span>Screenshot coming soon</span>
        </div>
      )
    }
  </div>
</div>

<style>
  .phone {
    position: relative;
    aspect-ratio: 1320 / 2868;
    padding: 3.2%;
    border-radius: 13% / 6%;
    background: linear-gradient(145deg, #2c3150, #12152a 45%, #262b47);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14),
      0 0 0 1px rgb(0 0 0 / 0.6),
      var(--shadow);
  }
  .screen {
    position: relative;
    height: 100%;
    border-radius: 10.5% / 4.9%;
    overflow: hidden;
    background: var(--bg-night-base);
  }
  .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: 1rem;
    text-align: center;
    font-family: var(--font-rounded);
    font-weight: 800;
    color: var(--text-secondary);
    background: radial-gradient(circle at 50% 40%, rgb(199 210 254 / 0.12), transparent 60%), var(--bg-night-base);
  }
  .moon {
    font-size: 2.5rem;
    color: var(--accent-moon);
  }
</style>
