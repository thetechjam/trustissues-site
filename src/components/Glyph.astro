---
/**
 * Hand-drawn stand-ins for the app's SF Symbol table (design-system.md §6).
 * SF Symbols can't be shipped on the web, so these are simple original glyphs
 * that map to the same concepts — one glyph per concept.
 */
export type GlyphName =
  | 'villager' | 'werewolf' | 'seer' | 'doctor' | 'minion' | 'jester' | 'hunter'
  | 'moon' | 'sun' | 'phone' | 'code' | 'cards' | 'vote' | 'people' | 'wifi' | 'apple' | 'mail' | 'arrow';

interface Props {
  name: GlyphName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
  {name === 'villager' && (
    <path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0 2c-4.4 0-8 2.3-8 5.2V21h16v-1.8c0-2.9-3.6-5.2-8-5.2Z" />
  )}
  {name === 'werewolf' && (
    <Fragment>
      <ellipse cx="6.2" cy="9.3" rx="2" ry="2.6" />
      <ellipse cx="10" cy="5.6" rx="2.1" ry="2.7" />
      <ellipse cx="14.6" cy="5.6" rx="2.1" ry="2.7" />
      <ellipse cx="18.2" cy="9.4" rx="2" ry="2.6" />
      <path d="M12.3 11.2c-2.7 0-5.6 3.4-5.6 6.1 0 1.8 1.3 2.7 2.8 2.7 1.2 0 1.8-.6 2.8-.6s1.6.6 2.8.6c1.5 0 2.8-.9 2.8-2.7 0-2.7-2.9-6.1-5.6-6.1Z" />
    </Fragment>
  )}
  {name === 'seer' && (
    <path fill-rule="evenodd" d="M12 5C6.8 5 3 9.3 1.8 12 3 14.7 6.8 19 12 19s9-4.3 10.2-7C21 9.3 17.2 5 12 5Zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-2.2a1.8 1.8 0 1 0 0-3.6 1.8 1.8 0 0 0 0 3.6Z" />
  )}
  {name === 'doctor' && (
    <path fill-rule="evenodd" d="M9 3.5h6A1.5 1.5 0 0 1 16.5 5v1.5H19a2.5 2.5 0 0 1 2.5 2.5v9a2.5 2.5 0 0 1-2.5 2.5H5A2.5 2.5 0 0 1 2.5 18V9A2.5 2.5 0 0 1 5 6.5h2.5V5A1.5 1.5 0 0 1 9 3.5Zm.5 3h5V5.5h-5v1Zm1.3 3.5v2.7H8.1v2.6h2.7V18h2.4v-2.7h2.7v-2.6h-2.7V10h-2.4Z" />
  )}
  {name === 'minion' && (
    <path fill-rule="evenodd" d="M3 4.5c3-1.3 6.3-1.3 9.5 0V10c0 3.6-2.1 6.2-4.75 6.2S3 13.6 3 10V4.5Zm2.3 4.1a1.3 1 0 1 0 2.6 0 1.3 1 0 0 0-2.6 0Zm4.1 0a1.3 1 0 1 0 2.6 0 1.3 1 0 0 0-2.6 0ZM6 12.3c1.2 1 2.4 1 3.5 0-.3 1.3-3.2 1.3-3.5 0ZM14 9.2c2.4-.7 4.8-.5 7 .5V15c0 3.6-2.1 6-4.6 6-1.9 0-3.4-1.3-4.1-3.2 1.7-1.6 1.7-3.6 1.7-5.4V9.2Zm1.6 3.6a1.2.9 0 1 0 2.4 0 1.2.9 0 0 0-2.4 0Zm-.1 4.7c1.2-1 2.5-1 3.6 0-.4-1.4-3.2-1.4-3.6 0Z" />
  )}
  {name === 'jester' && (
    <Fragment>
      <path d="M3 21 7.6 8.4l8 8L3 21Z" />
      <circle cx="15.5" cy="4" r="1.2" />
      <circle cx="20" cy="9" r="1.2" />
      <circle cx="19.5" cy="3.5" r="0.9" />
      <path d="M11.5 6.5c.4-1.8 1.4-3 2.5-3.5M17.5 12.5c1.8-.4 3-1.4 3.5-2.5M13.5 10.5l4.8-4.8" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
    </Fragment>
  )}
  {name === 'hunter' && (
    <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 3v4M12 17v4M3 12h4M17 12h4M12 19a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm0-6a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" />
  )}
  {name === 'moon' && (
    <Fragment>
      <path d="M14.5 3.2A8.5 8.5 0 1 0 20.8 15 7 7 0 0 1 14.5 3.2Z" />
      <path d="m19 2.5.6 1.6 1.6.6-1.6.6-.6 1.6-.6-1.6-1.6-.6 1.6-.6.6-1.6Z" />
