    </Fragment>
  )}
  {name === 'phone' && (
    <path fill-rule="evenodd" d="M8 1.5h8A2.5 2.5 0 0 1 18.5 4v16a2.5 2.5 0 0 1-2.5 2.5H8A2.5 2.5 0 0 1 5.5 20V4A2.5 2.5 0 0 1 8 1.5Zm.2 2.3v16.4h7.6V3.8h-1.6l-.5.9h-3.4l-.5-.9H8.2Z" />
  )}
  {name === 'code' && (
    <path fill-rule="evenodd" d="M4.5 6h15A2.5 2.5 0 0 1 22 8.5v7a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 15.5v-7A2.5 2.5 0 0 1 4.5 6Zm1.5 4v4h1.8v-4H6Zm3.3 0v4h1.8v-4H9.3Zm3.3 0v4h1.8v-4h-1.8Zm3.3 0v4h1.8v-4h-1.8Z" />
  )}
  {name === 'cards' && (
    <Fragment>
      <rect x="3" y="5" width="11" height="15" rx="2.2" transform="rotate(-10 8.5 12.5)" opacity=".5" />
      <rect x="9" y="3.5" width="11" height="15" rx="2.2" />
    </Fragment>
  )}
  {name === 'vote' && (
    <path d="M11.2 2.8a1.5 1.5 0 0 1 1.5 1.5v6.2h.6V5.3a1.5 1.5 0 1 1 3 0v6h.5V7.4a1.5 1.5 0 1 1 3 0v7.4c0 4-2.8 7-6.6 7-2.6 0-4.4-1.2-5.8-3.3L4.3 14a1.5 1.5 0 0 1 2.4-1.8l2 2.1V4.3a1.5 1.5 0 0 1 1.5-1.5h1Z" />
  )}
  {name === 'people' && (
    <path d="M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm-6.5 1a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2Zm13 0a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2ZM12 12.8c-3.4 0-6 1.8-6 4.2V19h12v-2c0-2.4-2.6-4.2-6-4.2Zm-7.8.6C2.4 13.7 1 14.9 1 16.4V18h3.5v-1c0-1.4.6-2.6 1.7-3.6h-2Zm15.6 0h-2c1.1 1 1.7 2.2 1.7 3.6v1H23v-1.6c0-1.5-1.4-2.7-3.2-3Z" />
  )}
  {name === 'wifi' && (
    <path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M2.5 9a14 14 0 0 1 19 0M5.8 12.6a9 9 0 0 1 12.4 0M9.1 16.1a4.2 4.2 0 0 1 5.8 0M12 19.6h0" />
  )}
  {name === 'apple' && (
    <path d="M16.4 12.6c0-2.4 2-3.5 2-3.6a4.3 4.3 0 0 0-3.4-1.8c-1.4-.2-2.8.8-3.5.8-.7 0-1.8-.8-3-.8a4.5 4.5 0 0 0-3.8 2.3c-1.6 2.8-.4 7 1.2 9.3.8 1.1 1.7 2.4 2.9 2.3 1.2 0 1.6-.7 3-.7s1.8.7 3 .7c1.3 0 2.1-1.1 2.8-2.3.9-1.3 1.3-2.6 1.3-2.6s-2.5-1-2.5-3.6ZM14.2 5.6c.6-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.1 1.8-1 2.9 1.1.1 2.2-.6 2.8-1.4Z" />
  )}
  {name === 'mail' && (
    <path d="M4 5h16a2 2 0 0 1 2 2v.4l-10 6.1L2 7.4V7a2 2 0 0 1 2-2Zm-2 4.7V17a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9.7l-10 6.1L2 9.7Z" />
  )}
  {name === 'arrow' && (
    <path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
