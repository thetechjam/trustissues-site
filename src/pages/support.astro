---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Glyph from '../components/Glyph.astro';
import { FAQ } from '../data/faq';
import { SITE, TESTFLIGHT_URL } from '../config';
import { faqPage } from '../lib/jsonld';

const mail = `mailto:${SITE.email}`;
const betaMail = `mailto:${SITE.email}?subject=${encodeURIComponent('Trust Issues TestFlight invite')}`;
---

<BaseLayout
  title="Support"
  description="Help with Trust Issues, the iPhone party game: contact, FAQ, player counts, remote play, data deletion and how to join the TestFlight beta."
  jsonLd={[faqPage(FAQ.map(({ q, a }) => ({ q, a })))]}
>
  <PageHeader eyebrow="Support" title="Need a hand?" narrator="Deadlock. The village agrees to disagree. We can help with that.">
    <div class="contact-card">
      <Glyph name="mail" class="mail-glyph" />
      <div>
        <p class="label">Email us</p>
        <a class="email" href={mail}>{SITE.email}</a>
        <p class="note">
          A real human (Jesse) reads every message. Expect a reply within a few business days, usually sooner. For bugs, include your iPhone
          model, iOS version and what was happening on screen.
        </p>
      </div>
    </div>
  </PageHeader>

  <section class="section" aria-labelledby="faq-title">
    <div class="container layout">
      <div class="faq">
        <h2 id="faq-title">Frequently asked questions</h2>
        <div class="faq-list">
          {
            FAQ.map((f, i) => (
              <details id={f.id} open={i === 0}>
                <summary>{f.q}</summary>
                <p>
                  {f.id === 'data' ? (
                    <Fragment>
                      {f.a.replace(' The Privacy Policy has the details.', ' ')}
                      The <a href="/privacy/">Privacy Policy</a> has the details.
                    </Fragment>
                  ) : f.id === 'delete' || f.id === 'stuck' ? (
                    <Fragment set:html={f.a.replace(SITE.email, `<a href="${mail}">${SITE.email}</a>`)} />
                  ) : (
                    f.a
                  )}
                </p>
              </details>
            ))
          }
        </div>
      </div>

      <aside id="beta" class="beta" aria-labelledby="beta-title">
        <p class="eyebrow"><Glyph name="moon" class="g" /> TestFlight beta</p>
        <h2 id="beta-title">Want in early?</h2>
        <p>
          Trust Issues is in beta on Apple’s TestFlight ahead of its App Store launch. Testers get new builds first and a direct line to the
          developer.
        </p>
        {
          TESTFLIGHT_URL ? (
            <Fragment>
              <ol>
                <li>Install Apple’s free TestFlight app on your iPhone.</li>
                <li>Open the invite link below on that iPhone and tap Accept.</li>
                <li>Install Trust Issues from TestFlight and round up three friends.</li>
              </ol>
              <a class="btn btn-primary" href={TESTFLIGHT_URL} rel="noopener">
                Join the TestFlight beta <Glyph name="arrow" />
              </a>
            </Fragment>
          ) : (
            <Fragment>
              <ol>
                <li>
                  Email <a href={betaMail}>{SITE.email}</a> and ask for a TestFlight invite. Mention the email address you use for your Apple
                  Account.
                </li>
                <li>Install Apple’s free TestFlight app on your iPhone.</li>
                <li>Accept the invite, install Trust Issues and round up three friends.</li>
              </ol>
              <a class="btn btn-primary" href={betaMail}>
                Email for an invite <Glyph name="arrow" />
              </a>
            </Fragment>
          )
        }
        <p class="fine">Beta builds can be rough around the edges. Bug reports are extremely welcome.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-card {
    margin-top: 2rem;
    max-width: 40rem;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--bg-night-elevated);
    box-shadow: inset 0 0 0 1px rgb(167 139 250 / 0.25);
  }
  .contact-card :global(.mail-glyph) {
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.55rem;
    border-radius: 12px;
    background: rgb(167 139 250 / 0.15);
    color: var(--accent-primary);
  }
  .label {
    font-family: var(--font-rounded);
    font-weight: 800;
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .email {
    display: inline-block;
    font-family: var(--font-rounded);
    font-weight: 900;
    font-size: var(--step-2);
    word-break: break-word;
    margin-block: 0.15rem 0.4rem;
  }
  .note {
    color: var(--text-secondary);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: start;
  }
  .faq h2 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .faq-list {
    display: grid;
    gap: 0.6rem;
  }
  details {
    border-radius: var(--radius-card);
    background: var(--bg-night-elevated);
    box-shadow: inset 0 0 0 1px var(--rule);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  summary {
    cursor: pointer;
    list-style: none;
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.2rem;
    font-family: var(--font-rounded);
    font-weight: 800;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex: none;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--accent-primary);
    transition: transform 0.25s var(--ease-out);
  }
  details[open] summary::after {
    transform: rotate(45deg);
  }
  details p {
    padding: 0 1.2rem 1.2rem;
    color: var(--text-secondary);
  }
  .beta {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    padding: 1.75rem;
    border-radius: var(--radius-sheet);
    background:
      radial-gradient(18rem 12rem at 100% 0%, rgb(167 139 250 / 0.22), transparent 70%),
      var(--bg-night-raised);
    box-shadow: inset 0 0 0 1px rgb(167 139 250 / 0.3);
    display: grid;
    gap: 1rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .beta :global(.g) {
    width: 1.1em;
    height: 1.1em;
  }
  .beta h2 {
    font-size: var(--step-3);
  }
  .beta p,
  .beta ol {
    color: var(--text-secondary);
  }
  .beta ol {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
  }
  .beta ol li::marker {
    color: var(--accent-primary);
    font-weight: 800;
  }
  .beta .btn {
    justify-self: start;
  }
  .beta .btn :global(svg) {
    width: 1.1rem;
  }
  .fine {
    font-size: var(--step--1);
  }
  .beta:target {
    box-shadow:
      inset 0 0 0 2px var(--accent-primary),
      0 0 40px -10px rgb(167 139 250 / 0.6);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .beta {
      position: static;
    }
  }
</style>
